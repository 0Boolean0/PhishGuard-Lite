{
  "manifest_version": 3,
  "name": "PhishGuard-Lite",
  "version": "1.0",
  "description": "Detects phishing websites in real-time.",
  "permissions": ["tabs", "activeTab"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}